@@ -0,0 +1,29 @@
+// Трекер затемнения нефокусного окна (находка Н1, дизайн §3(А), решение 1):
+// dimmed ⟺ blurred && visible. «visible» отделяет десктопный сценарий «окно
+// видно, фокус в другом приложении» от мобильного app-switch, где страница
+// hidden и затемнять нечего (Review Focus 4). Чистый: DOM не читает — события
+// и visibility скармливает хук use-focus-dim; начальное состояние — видимая
+// сфокусированная страница.
+export interface FocusDimTracker {
+  dimmed(): boolean;
+  onBlur(): void;
+  onFocus(): void;
+  onVisibility(visible: boolean): void;
+}
+
+export function createFocusDimTracker(): FocusDimTracker {
+  let blurred = false;
+  let visible = true;
+  return {
+    dimmed: () => blurred && visible,
+    onBlur: () => {
+      blurred = true;
+    },
+    onFocus: () => {
+      blurred = false;
+    },
+    onVisibility: (v: boolean) => {
+      visible = v;
+    },
+  };
+}
diff --git a/apps/web/src/state/use-focus-dim.ts b/apps/web/src/state/use-focus-dim.ts
new file mode 100644
index 0000000..28d3e2d
--- /dev/null
+++ b/apps/web/src/state/use-focus-dim.ts
@@ -0,0 +1,37 @@
+import { useEffect, useState } from 'react';
+import { createFocusDimTracker } from './focus-dim';
+
+// React-клей трекера затемнения (дизайн §3(А)): blur/focus на window,
+// visibilitychange на document, cleanup снимает всех слушателей. Текущая
+// visibility подаётся в трекер и на blur тоже: macOS может отдать blur до
+// перехода вкладки в hidden — порядок событий браузером не гарантирован,
+// поэтому каждое событие несёт свежий снимок document.visibilityState.
+export function useFocusDim(): boolean {
+  const [dimmed, setDimmed] = useState(false);
+  useEffect(() => {
+    const tracker = createFocusDimTracker();
+    const sync = () => setDimmed(tracker.dimmed());
+    const onBlur = () => {
+      tracker.onVisibility(document.visibilityState === 'visible');
+      tracker.onBlur();
+      sync();
+    };
+    const onFocus = () => {
+      tracker.onFocus();
+      sync();
+    };
+    const onVisibility = () => {
+      tracker.onVisibility(document.visibilityState === 'visible');
+      sync();
+    };
+    window.addEventListener('blur', onBlur);
+    window.addEventListener('focus', onFocus);
+    document.addEventListener('visibilitychange', onVisibility);
+    return () => {
+      window.removeEventListener('blur', onBlur);
+      window.removeEventListener('focus', onFocus);
+      document.removeEventListener('visibilitychange', onVisibility);
+    };
+  }, []);
+  return dimmed;
+}
