+// rosterEntrySchema (SDK, strict): { identityId: uuid, displayName: string|null,
+// role: lowercase } — joinedAt на wire НЕТ, фикстура минимальна.
+const entry = (identityId: string): RosterEntry => ({
+  identityId,
+  displayName: 'Игрок',
+  role: 'participant',
+});
