+        new Promise<string>((resolve) => {
+          calls += 1;
+          resolveFn = resolve;
+        }),
+    );
+
+    const p1 = store.refresh();
+    const p2 = store.refresh();
+    const p3 = store.refresh();
+    resolveFn('tok-1');
+    await Promise.all([p1, p2, p3]);
