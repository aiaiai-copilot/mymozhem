+  padding: 14px 16px 16px;
+  background: var(--console-strip);
+  border-radius: 8px;
+  text-align: center;
+}
+.console-wb-label {
+  color: var(--muted);
+  font-size: 12px;
+  letter-spacing: 0.09em;
+  text-transform: uppercase;
