+describe('remainingSec', () => {
+  const now = Date.parse('2026-10-20T12:00:00.000Z');
+
+  it('durationSec = null («без лимита») → null', () => {
+    expect(remainingSec(null, '2026-10-20T12:00:00.000Z', now)).toBeNull();
+  });
