+            /* Колода кончилась: по иерархии «следующее действие» остаётся
+               одно — завершить квиз, он и становится главной кнопкой. */
+            <button
+              type="button"
+              className="btn btn-primary"
+              disabled={disabled}
+              onClick={finishQuiz}
+            >
+              Завершить квиз
+            </button>
+          ) : (
+            <>
+              {/* Подпись 1-based для ведущего (openQuestionLabel), payload
+                  остаётся 0-based (questionIndex: next) — так ждёт модуль. */}
+              <button
+                type="button"
+                className="btn btn-primary"
+                disabled={disabled || deckExhausted}
+                onClick={() => onCommand('quiz.question.opened', { questionIndex: next })}
+              >
+                {openQuestionLabel(next, nextDurationSec)}
+              </button>
+              {current !== null ? (
+                <button
+                  type="button"
+                  className="btn btn-quiet"
+                  disabled={disabled}
+                  onClick={finishQuiz}
+                >
+                  Завершить квиз досрочно
+                </button>
+              ) : null}
+            </>
+          )}
+        </div>
+      </section>
+      {commandError ? (
+        <p role="alert" className="console-error">
+          {commandError}
         </p>
       ) : null}
-      <p>
-        {/* disabled, пока accepting: второй open до close модуль отклонит,
-            но и не даём ведущему нажать его зря; deckExhausted — вопросы
-            кончились. Подпись 1-based для ведущего (как статус-строка выше),
-            а payload остаётся 0-based (questionIndex: next) — так ждёт модуль. */}
-        <button
-          type="button"
-          disabled={disabled || quiz.accepting || deckExhausted}
-          onClick={() => onCommand('quiz.question.opened', { questionIndex: next })}
-        >
-          Открыть вопрос {next + 1}
-        </button>{' '}
-        <button
-          type="button"
-          disabled={disabled || !quiz.accepting || current === null}
-          onClick={() => {
-            if (current !== null) onCommand('quiz.question.closed', { questionIndex: current });
-          }}
-        >
-          Закрыть вопрос
