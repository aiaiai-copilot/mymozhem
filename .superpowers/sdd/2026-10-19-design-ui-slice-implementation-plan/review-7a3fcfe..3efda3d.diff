+}
+
+/* Полоса комнаты: логотип, связь, код; sticky — статус виден при прокрутке
+   секций (мокап console-phone-landscape-v2 .strip). */
+.console-strip {
+  position: sticky;
+  top: 0;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 10px 16px;
+  background: var(--console-strip);
+  font-size: 14px;
+}
+.console-conn {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  /* Литерал мокапа (--ok #2F6B4F): в токенах T4 ok-зелёного нет
+     (прецедент литерала — .play-input::placeholder в scene.css). */
+  color: #2f6b4f;
+  font-size: 13px;
+  font-weight: 700;
+}
+.console-conn.off { color: var(--error-light); }
+.console-conn-dot {
+  width: 9px;
+  height: 9px;
+  border-radius: 50%;
+  background: currentColor;
+}
+.console-room-code {
+  margin-left: auto;
+  font-weight: 700;
+  letter-spacing: 0.06em;
+}
+
+/* Баннер обрыва связи (мокап console-empty-long-errors-v2 .error-banner) */
+.console-error-banner {
+  margin: 14px 14px 0;
+  padding: 12px 16px;
+  background: var(--error-light);
+  color: var(--scene-text);
+  border-radius: 10px;
+  font-size: 14px;
+  font-weight: 700;
+  line-height: 1.4;
+}
+.console-error-sub {
+  display: block;
+  margin-top: 2px;
+  font-weight: 400;
+  font-size: 13px;
+  opacity: 0.9;
+}
+
+/* Ошибка publish-команды и служебные заметки статуса */
+.console-error {
+  margin: 0 14px 12px;
+  color: var(--error-light);
+  font-weight: 700;
+}
+.console-note { margin: 14px; color: var(--muted); }
+.console-muted { color: var(--muted); }
+
+/* --- Hero: текущий момент + действия (иерархия п. 10) --- */
+.console-hero {
+  margin: 14px;
+  padding: 18px 18px 20px;
+  background: var(--console-panel);
+  border-radius: 12px;
+}
+.console-q-label {
+  margin-bottom: 4px;
+  color: var(--muted);
+  font-size: 13px;
+  letter-spacing: 0.09em;
+  text-transform: uppercase;
+}
+.console-q-text {
+  margin-bottom: 14px;
+  font-family: var(--font-display);
+  font-size: 22px;
+  line-height: 1.25;
+}
+
+/* Игра: таймер + live-счётчик (мокап console-phone-landscape-v2 .live-row) */
+.console-live-row {
+  display: flex;
+  align-items: baseline;
+  gap: 18px;
+  margin-bottom: 16px;
+}
+.console-timer {
+  font-family: var(--font-display);
+  font-size: 52px;
+  line-height: 1;
+  font-variant-numeric: tabular-nums;
+}
+.console-timer small {
+  display: block;
+  margin-top: 4px;
+  color: var(--muted);
+  font-family: var(--font-body);
+  font-size: 12px;
+  letter-spacing: 0.09em;
+  text-transform: uppercase;
+}
+.console-answered { font-size: 15px; }
+.console-answered b { font-size: 22px; }
+.console-answered-bar {
+  width: 130px;
+  height: 6px;
+  margin-top: 6px;
+  background: var(--track-canvas-light);
+  border-radius: 3px;
+  overflow: hidden;
+}
+.console-answered-bar i {
+  display: block;
+  height: 100%;
+  background: var(--console-primary);
+  border-radius: 3px;
+}
+
+/* Reveal: ответ плашкой + разбор раунда (мокап console-reveal-final-button) */
+.console-correct {
+  margin-bottom: 14px;
+  padding: 10px 14px;
+  background: var(--console-strip);
+  border-radius: 8px;
+}
+.console-ca-label {
+  display: block;
+  color: var(--muted);
+  font-size: 12px;
+  letter-spacing: 0.09em;
+  text-transform: uppercase;
+}
+.console-ca-value {
+  display: block;
+  font-family: var(--font-display);
+  font-size: 22px;
+}
+.console-round-stats {
+  display: flex;
+  gap: 22px;
+  margin-bottom: 16px;
+  font-size: 14px;
+}
+.console-round-stats b {
+  display: block;
+  font-family: var(--font-display);
+  font-size: 30px;
+  font-weight: 400;
+  line-height: 1.1;
+}
+.console-round-stats span { color: var(--muted); font-size: 13px; }
+
+/* «Квиз окончен» (мокап console-quiz-finished) */
+.console-fh-title {
+  margin-bottom: 10px;
+  font-family: var(--font-display);
+  font-size: 26px;
+}
+.console-fh-sub {
+  margin-bottom: 16px;
+  color: var(--muted);
+  font-size: 14px;
+  line-height: 1.45;
+}
+.console-fh-note {
+  margin: 0;
+  color: var(--muted);
+  font-size: 13px;
+  text-align: center;
+}
+
+/* Действия: главная кнопка во всю ширину, тихая ниже (мокап .btn) */
+.console-actions {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+.console-actions .btn { display: block; width: 100%; }
+.console-btn-note { font-weight: 400; color: var(--muted); }
+
+/* Тихие кнопки консоли приглушены (мокап .btn-quiet opacity .75);
+   :not(:disabled) — не перекрывать disabled-описание системы (.btn:disabled) */
+.console-page .btn-quiet:not(:disabled) { opacity: 0.75; font-size: 14px; }
+
+/* --- Секции: карточки панелей (мокап .section-card) --- */
+.console-sections { margin: 0 14px; }
+.console-card {
+  margin-bottom: 12px;
+  padding: 14px 16px;
+  background: var(--console-panel);
+  border-radius: 12px;
+  font-size: 14px;
+}
+.console-card-title {
+  margin: 0 0 10px;
+  color: var(--muted);
+  font-family: var(--font-body);
+  font-size: 13px;
+  letter-spacing: 0.09em;
+  text-transform: uppercase;
+}
+.console-link-row { padding: 5px 0; }
+.console-copy { padding: 6px 12px; font-size: 13px; }
+
+/* «ещё N — развернуть» (I-5): интерактивный toggle заменяет статичный
+   .tr-more, который RaceTracks рисует при topN, — внутри консольной
+   обёртки статичный скрыт, чтобы не дублировать строку. */
+.console-tracks .race-tracks .tr-more { display: none; }
+.console-tracks-toggle {
+  margin-top: 6px;
+  padding: 0;
+  background: none;
+  border: none;
+  color: var(--muted);
+  font: 13px var(--font-body);
+  cursor: pointer;
+}
+.console-tracks-toggle:focus-visible {
+  outline: 3px solid var(--console-primary);
+  outline-offset: 2px;
+}
+
+/* Тихая «Завершить событие» внизу страницы (п. 10) */
+.console-finish { display: block; width: calc(100% - 28px); margin: 0 14px; }
+
+/* «Комната не найдена» (мокап console-empty-long-errors-v2 .lost-card) */
+.console-lost {
+  margin: 14px;
+  padding: 22px 18px;
+  background: var(--console-panel);
+  border-radius: 12px;
+  text-align: center;
+}
+.console-lost-title {
+  margin-bottom: 8px;
+  font-family: var(--font-display);
+  font-size: 24px;
+}
+.console-lost-sub {
+  margin: 0 0 16px;
+  color: var(--muted);
+  font-size: 14px;
+  line-height: 1.5;
+}
+.console-lost-btn { display: inline-block; text-decoration: none; }
+
+/* --- Ландшафт-правило (п. 11): при высоте ≤400px первый экран = статус +
+   момент + главная кнопка без прокрутки — две колонки, действия справа
+   (мокап console-phone-landscape-v2 .land-grid/.actions-col) --- */
+@media (orientation: landscape) and (max-height: 400px) {
+  .console-hero {
+    display: grid;
+    grid-template-columns: 1fr 220px;
+    gap: 12px;
+    align-items: center;
+    margin: 12px;
+    padding: 14px 16px 16px;
+  }
+  .console-hero .console-q-text { font-size: 19px; margin-bottom: 10px; }
+  .console-live-row { margin-bottom: 0; gap: 16px; }
+  .console-timer { font-size: 44px; }
+  .console-correct { padding: 8px 12px; margin-bottom: 10px; }
+  .console-correct .console-ca-value { font-size: 19px; }
+  .console-round-stats { margin-bottom: 0; gap: 18px; }
+  .console-round-stats b { font-size: 24px; }
+  .console-fh-sub { margin-bottom: 0; }
+  .console-actions .btn-primary { font-size: 16px; padding: 13px 12px; }
+  /* Секции ниже первого экрана — в два столбца (мокап .land-below) */
+  .console-sections {
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: 12px;
+    margin: 0 12px;
+  }
+  .console-sections .console-card { margin-bottom: 0; }
+  .console-finish { width: calc(100% - 24px); margin: 12px; }
+}
diff --git a/apps/web/src/styles/scene.css b/apps/web/src/styles/scene.css
new file mode 100644
index 0000000..1af3792
--- /dev/null
+++ b/apps/web/src/styles/scene.css
@@ -0,0 +1,212 @@
+/* Тёмная сцена — контур участника (/play), дизайн §4/§5.1, п. 6/7/12/13/17/18.
+   Значения перенесены из мокапов-эталонов: participant-join-lobby-center-fix,
+   participant-flow-layout-v2, participant-long-content, game-states (сессия 44),
+   timer-projector-participant, tracks-scene-with-logo (сессия 45); цвета —
+   токены T4. Стили логотипа живут здесь же (компонент несёт начертание/цвет/
+   кегль, позиционирование — у страницы, ruling C-1). Размещение — отдельным
+   файлом от transitions.css: там система состояний, здесь раскладка экранов
+   (ruling C-2); проектор (T8) — соседний screen.css. */
+
+/* --- Логотип (ruling C-1) --- */
+.logo {
+  font-family: var(--font-logo);
+  font-weight: 400;
+  line-height: 1.2;
+  letter-spacing: 0.02em;
+}
+.logo-scene { color: var(--gold); }
+.logo-console { color: var(--console-primary); }
+.logo-participant { font-size: 19px; }
+.logo-projector { font-size: 22px; }
+
+/* --- Страница участника --- */
+.play-page {
+  /* position:relative — опора центрирования ожидания (п. 7) */
+  position: relative;
+  min-height: 100vh;
+  min-height: 100dvh;
+  padding: 21px 18px 23px;
+  background: var(--scene-bg);
+  color: var(--scene-text);
+}
+/* Логотип участника — по центру вверху (п. 17); позиционирование — обязанность
+   страницы, не компонента (ruling C-1). */
+.play-page .logo { text-align: center; }
+
+/* Заголовок экрана (вход/ожидание/финал) — мокапы center-fix/flow-v2/edge */
+.play-title {
+  margin: 30px 0 21px;
+  color: var(--gold);
+  font-family: var(--font-display);
+  font-size: 30px;
+  line-height: 1.1;
+  font-weight: 400;
+}
+
+/* Вход (мокап participant-join-lobby-center-fix): золотые подписи, поля
+   --input-scene с тёмным текстом */
+.play-field {
+  display: grid;
+  gap: 7px;
+  margin-bottom: 17px;
+  color: var(--gold);
+  font-size: 14px;
+}
+.play-input {
+  width: 100%;
+  min-height: 49px;
+  padding: 11px 12px;
+  color: var(--scene-bg);
+  background: var(--input-scene);
+  border: 0;
+  border-radius: 4px;
+  font: 16px var(--font-body);
+}
+/* Литерал мокапа входа (в токенах T4 нет цвета placeholder) */
+.play-input::placeholder { color: #354b41; }
+.play-input:focus-visible {
+  outline: 3px solid var(--gold);
+  outline-offset: 2px;
+}
+
+/* Кнопка «Играть» — вариант сцены по мокапу входа (НЕ консольный .btn-primary,
+   I-9): поверхность сцены + золотой текст. Состояния hover/active/focus/disabled
+   наследует от .btn/.btn-scene (transitions.css). */
+.btn-join {
+  width: 100%;
+  min-width: 0;
+  min-height: 52px;
+  margin-top: 34px;
+  padding: 13px 22px;
+  color: var(--gold);
+  font-weight: 700;
+  font-size: 17px;
+  text-align: center;
+  border-radius: 4px;
+}
+
+/* Ошибки на тёмной сцене — плотное начертание (п. 6) */
+.play-error { color: var(--error-dark); font-weight: 700; }
+
+/* Ожидание: центрирование относительно всей высоты, логотип/заголовок не влияют
+   (п. 7, мокап center-fix: top 50% + translateY(-50%)) */
+.play-waiting {
+  position: absolute;
+  top: 50%;
+  left: 18px;
+  right: 18px;
+  transform: translateY(-50%);
+  margin: 0;
+  color: rgba(246, 237, 220, 0.82);
+  font-size: 17px;
+  line-height: 1.5;
+}
+
+/* Вопрос: верхняя строка — номер + таймер 40px (п. 12, мокап
+   timer-projector-participant); «без лимита» — таймера нет вообще */
+.play-strip {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  margin-top: 29px;
+}
+.play-kicker {
+  color: var(--gold);
+  font-family: var(--font-display);
+  font-size: 16px;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+.play-timer {
+  font-family: var(--font-display);
+  font-size: 40px;
+  line-height: 1;
+  color: var(--gold);
+  font-variant-numeric: tabular-nums;
+}
+/* Нижние 30px — отступ перед вариантами (п. 7) */
+.play-question {
+  margin: 10px 0 30px;
+  font-family: var(--font-display);
+  font-size: 28px;
+  line-height: 1.13;
+  font-weight: 400;
+}
+.play-options {
+  display: grid;
+  gap: 11px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+/* Вариант на всю ширину; длинный текст переносится, кнопка растёт по высоте
+   (п. 7, мокап participant-long-content); внутренних скроллов нет */
+.play-options .btn-scene {
+  width: 100%;
+  min-width: 0;
+}
+
+/* Reveal (мокап game-states): вердикт различается значком, текстом и цветом.
+   success/danger — литералы мокапа (в токенах T4 нет success-цвета). */
+.play-verdict {
+  margin: 28px 0 4px;
+  font-family: var(--font-display);
+  font-size: 38px;
+  font-weight: 400;
+}
+.play-verdict-success { color: #8fcaa5; }
+.play-verdict-danger { color: #e5a092; }
+.play-points {
+  margin: 0 0 17px;
+  color: var(--gold);
+  font-size: 18px;
+  font-weight: 700;
+}
+/* «Правильный отвѣтъ» — плашка с золотой кромкой (мокап game-states) */
+.play-correct {
+  margin: 18px 0;
+  padding: 13px 14px;
+  background: var(--scene-surface);
+  border-left: 3px solid var(--gold);
+}
+.play-correct-label {
+  color: var(--gold);
+  font-family: var(--font-display);
+  font-size: 16px;
+  letter-spacing: 0.04em;
+}
+.play-correct-answer {
+  margin-top: 4px;
+  font-family: var(--font-display);
+  font-size: 28px;
+}
+
+/* Шапка табло: заголовок + моё место (п. 13, myPlace) */
+.play-standings-head {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  margin: 19px 0 8px;
+}
+.play-standings-title {
+  color: var(--gold);
+  font-family: var(--font-display);
+  font-size: 21px;
+}
+.play-standings-place { color: var(--muted-scene); font-size: 14px; }
+
+/* Победители розыгрыша (только если розыгрыш был, п. 18) */
+.play-winners { margin-top: 22px; }
+.play-winners h2 {
+  margin: 0 0 8px;
+  color: var(--gold);
+  font-family: var(--font-display);
+  font-size: 20px;
+  font-weight: 400;
+}
+.play-winners ul {
+  margin: 0;
+  padding-left: 19px;
+  font-size: 15px;
+  line-height: 1.5;
+}
diff --git a/apps/web/src/styles/screen.css b/apps/web/src/styles/screen.css
new file mode 100644
index 0000000..3a8245e
--- /dev/null
+++ b/apps/web/src/styles/screen.css
@@ -0,0 +1,202 @@
+/* Тёмная сцена — контур проектора (/screen), дизайн §5.2, п. 8/12/13/17/18.
+   Значения перенесены из мокапов-эталонов: timer-projector-participant,
+   tracks-scene-with-logo (сессия 45), projector-options-no-lines,
+   projector-final-winners-large, projector-long-content (сессия 44); цвета —
+   токены T4. Проектор read-only (п. 8): ни кнопок, ни форм, ни focus-стилей.
+   Размещение — соседним файлом к scene.css (ruling C-2): там контур
+   участника, здесь проектор; общее у них только .logo (живёт в scene.css).
+   Заменяет временные .screen-question/.screen-options из base.css (бриф T8). */
+
+/* --- Каркас (п. 8/17) --- */
+.screen-page {
+  /* position:relative — опора центрирования ожидания во всём кадре (п. 8) */
+  position: relative;
+  min-height: 100vh;
+  min-height: 100dvh;
+  /* pj-inner мокапа timer-projector-participant */
+  padding: 34px 44px;
+  background: var(--scene-bg);
+  color: var(--scene-text);
+}
+/* Логотип — левый верхний угол на всех экранах (п. 17); позиционирование —
+   обязанность страницы (ruling C-1). Отступ снизу — pj-brand мокапа
+   tracks-scene-with-logo. */
+.screen-page .logo { margin-bottom: 14px; }
+
+/* Ожидание/системные сообщения: центрирование во всём кадре (п. 8), логотип
+   не влияет (та же механика, что .play-waiting у участника, п. 7). */
+.screen-waiting {
+  position: absolute;
+  top: 50%;
+  left: 44px;
+  right: 44px;
+  transform: translateY(-50%);
+  margin: 0;
+  color: rgba(246, 237, 220, 0.82);
+  font-size: 24px;
+  line-height: 1.5;
+  text-align: center;
+}
+
+/* «Игра идёт. Ждём вопрос…» — в потоке (под ним могут быть победители
+   лотереи), мокапа этого состояния нет — минимальная крупная подача. */
+.screen-note {
+  margin: 40px 0 0;
+  font-size: 24px;
+}
+
+/* --- Вопрос (п. 8/12, мокапы timer-projector-participant и
+   projector-options-no-lines) --- */
+/* Верхняя строка: «Вопросъ N из M» слева, таймер справа (pj-top). */
+.screen-strip {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  margin-bottom: 18px;
+}
+.screen-kicker {
+  color: var(--gold);
+  font-family: var(--font-display);
+  font-size: 18px;
+  letter-spacing: 0.09em;
+  text-transform: uppercase;
+}
+/* Таймер 56px золотом справа вверху, tabular-nums; «без лимита» — не
+   рендерится вообще; ноль — спокойный 0:00, без краснухи (п. 12). */
+.screen-timer {
+  display: flex;
+  align-items: baseline;
+  gap: 10px;
+  color: var(--gold);
+  font-family: var(--font-display);
+  font-size: 56px;
+  line-height: 1;
+  font-variant-numeric: tabular-nums;
+}
+.screen-timer small {
+  color: var(--muted-scene);
+  font-family: var(--font-body);
+  font-size: 14px;
+  letter-spacing: 0.09em;
+  text-transform: uppercase;
+}
+/* Отступ перед вариантами 35px (п. 8) */
+.screen-question {
+  max-width: 850px;
+  margin: 0 0 35px;
+  font-family: var(--font-display);
+  font-size: 38px;
+  line-height: 1.2;
+  font-weight: 400;
+}
+.screen-options {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 12px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+  font-size: 19px;
+}
+/* Варианты — общая поверхность, без золотых вертикальных линий (п. 8,
+   projector-options-no-lines); буквенная метка золотом (timer-мокап). */
+.screen-options li {
+  display: flex;
+  align-items: center;
+  padding: 14px 18px;
+  background: var(--scene-surface);
+  border-radius: 10px;
+  line-height: 1.25;
+}
+.screen-options li b { color: var(--gold); margin-right: 10px; }
+
+/* Компактная плотность: длинный вопрос / более четырёх вариантов (п. 8,
+   projector-options-no-lines / projector-long-content; переключение —
+   isCompactQuestion, state/question-density.ts). */
+.screen-question-compact { font-size: 34px; line-height: 1.12; }
+.screen-options-compact { gap: 10px 20px; }
+.screen-options-compact li { min-height: 48px; padding: 9px 12px; }
+
+/* --- Reveal (п. 8/13, мокап tracks-scene-with-logo): «Правильный отвѣтъ»
+   слева, табло дорожками справа (топ-4 + «ещё N» — в компоненте) --- */
+.screen-reveal {
+  display: grid;
+  grid-template-columns: 1fr 1.1fr;
+  gap: 36px;
+}
+.screen-answer-label {
+  margin-bottom: 10px;
+  color: var(--muted-scene);
+  font-size: 14px;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+}
+.screen-answer-value {
+  margin: 0;
+  color: var(--gold);
+  font-family: var(--font-display);
+  font-size: 40px;
+  line-height: 1.2;
+  font-weight: 400;
+}
+.screen-board-title {
+  margin-bottom: 12px;
+  color: var(--muted-scene);
+  font-size: 14px;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+}
+
+/* Кегли дорожек проектора крупнее участника (мокап tracks-scene-with-logo:
+   имя 16px, счёт 15px, дельта 13px, полотно 9px) — читаемость с расстояния.
+   База дорожек — transitions.css, здесь только переопределение размеров. */
+.screen-page .race-tracks .track-row { padding: 5px 0 7px; }
+.screen-page .race-tracks .tr-name { font-size: 16px; }
+.screen-page .race-tracks .tr-score { font-size: 15px; }
+.screen-page .race-tracks .tr-score .delta { font-size: 13px; }
+.screen-page .race-tracks .tr-lane { height: 9px; }
+
+/* --- Финал (п. 8/13/18, мокапы tracks-scene-with-logo и
+   projector-final-winners-large): табло топ-5 дорожками слева, победители —
+   центрированный блок в свободной правой зоне --- */
+.screen-final-title {
+  margin: 15px 0 17px;
+  color: var(--gold);
+  font-family: var(--font-display);
+  font-size: 35px;
+  font-weight: 400;
+}
+.screen-final-grid {
+  display: grid;
+  grid-template-columns: 1.2fr 1fr;
+  gap: 36px;
+}
+/* Без розыгрыша блок победителей не рендерится, табло центрируется на всю
+   зону (п. 18); ширина колонки 720px — допущение имплементера (мокап этого
+   состояния не показывает), к ревью. */
+.screen-final-solo {
+  grid-template-columns: minmax(0, 720px);
+  justify-content: center;
+}
+/* Заголовок 32px, имена 24px (бриф/п. 8 — projector-final-winners-large).
+   Стилизация со стороны страницы: разметка Winners (section/h2/ul) общая
+   с play/console и не меняется. */
+.screen-winners {
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+}
+.screen-winners h2 {
+  margin: 0 0 13px;
+  color: var(--gold);
+  font-family: var(--font-display);
+  font-size: 32px;
+  line-height: 1.15;
+  font-weight: 400;
+}
+.screen-winners ul {
+  margin: 0;
+  padding-left: 23px;
+  font-size: 24px;
+  line-height: 1.55;
+}
