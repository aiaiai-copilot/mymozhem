index 0000000..9e9dfb7
--- /dev/null
+++ b/apps/web/src/styles/tokens.spec.ts
@@ -0,0 +1,126 @@
+import { describe, expect, it } from 'vitest';
+import { readFileSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+
+// Типы node:fs/node:url — в соседнем node-test-shims.d.ts: apps/web —
+// браузерный пакет без @types/node (tsconfig: types ["vite/client"]), но spec
+// исполняется vitest в node-окружении (vite.config test.environment).
+
+// Контракт визуального фундамента (T4): токены темы «rybinsk» и кнопочная
+// система состояний. Значения — verbatim из брифа (дизайн §4 + принятый мокап
+// component-states-live); спек ловит случайный дрейф значений.
+
+const readStyle = (name: string): string =>
+  readFileSync(fileURLToPath(new URL(`./${name}`, import.meta.url)), 'utf8');
+
+const escapeRe = (s: string): string => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+
+// Извлекает блок @media по подстроке запроса со сбалансированными скобками.
+// Возвращает [блок, css без блока] — нужно, чтобы проверить, что hover-правила
+// не существуют вне медиа-запроса (hover: hover) and (pointer: fine).
+function extractMediaBlock(css: string, query: string): [string, string] {
+  const start = css.indexOf(query);
+  expect(start, `медиа-запрос ${query} должен присутствовать`).toBeGreaterThanOrEqual(0);
+  const mediaStart = css.lastIndexOf('@media', start);
+  const openBrace = css.indexOf('{', start);
+  let depth = 0;
+  let end = -1;
+  for (let i = openBrace; i < css.length; i += 1) {
+    if (css[i] === '{') depth += 1;
+    if (css[i] === '}') {
+      depth -= 1;
+      if (depth === 0) {
+        end = i;
+        break;
+      }
+    }
+  }
+  expect(end, `медиа-запрос ${query} должен быть закрыт`).toBeGreaterThan(-1);
+  const block = css.slice(mediaStart, end + 1);
+  return [block, css.slice(0, mediaStart) + css.slice(end + 1)];
+}
+
+describe('tokens.css — токены темы rybinsk', () => {
+  const css = readStyle('tokens.css');
+
+  const exactTokens: Array<[string, string]> = [
+    // сцена (тёмный контур)
+    ['--scene-bg', '#0A252B'],
+    ['--scene-surface', '#1B3B40'],
+    ['--scene-surface-hover', '#23484D'],
+    ['--scene-surface-active', '#122E32'],
+    ['--gold', '#E6C77D'],
+    ['--scene-text', '#F6EDDC'],
+    ['--muted-scene', '#9DB8B2'],
+    ['--error-dark', '#F27668'],
+    ['--input-scene', '#A9BDB2'],
+    ['--track-fill', '#0F7B57'],
+    ['--track-canvas-dark', '#143138'],
+    // консоль (светлый контур)
+    ['--console-bg', '#E3F0E9'],
+    ['--console-panel', '#F4F8F3'],
+    ['--console-strip', '#D7E8DE'],
+    ['--console-secondary', '#C4D8CC'],
+    ['--console-primary', '#10514F'],
+    ['--console-primary-hover', '#17685F'],
+    ['--console-primary-active', '#0A3E3B'],
+    ['--console-secondary-hover', '#B4CDBC'],
+    ['--console-secondary-active', '#A3BFA9'],
+    ['--ink', '#12343A'],
+    ['--muted', '#5A6B66'],
+    ['--error-light', '#A92820'],
+    ['--track-canvas-light', '#D5E2DA'],
+    ['--danger-hover', '#F3DCD2'],
+    ['--danger-active', '#ECCFC4'],
+    // тайминги
+    ['--t-hover', '140ms'],
+    ['--t-press', '60ms'],
+    ['--t-race', '300ms'],
+  ];
+
+  it('все токены объявлены под :root с точными значениями', () => {
+    expect(css).toContain(':root');
+    for (const [name, value] of exactTokens) {
+      const re = new RegExp(`${escapeRe(name)}\\s*:\\s*${escapeRe(value)}\\s*;`);
+      expect(css, `ожидался токен ${name}: ${value};`).toMatch(re);
+    }
+  });
+
+  it('шрифтовые токены указывают на self-hosted семейства', () => {
+    const fontTokens: Array<[string, string]> = [
+      ['--font-logo', "'Oranienbaum'"],
+      ['--font-display', "'Oranienbaum'"],
+      ['--font-body', "'PT Sans'"],
+    ];
+    for (const [name, family] of fontTokens) {
+      const m = css.match(new RegExp(`${escapeRe(name)}\\s*:\\s*([^;]+);`));
+      expect(m, `ожидался токен ${name}`).not.toBeNull();
+      expect(m![1]).toContain(family);
+    }
+  });
+
+  it('точка расширения темы зафиксирована: вторая тема = переопределение под [data-theme=…]', () => {
+    expect(css).toContain('[data-theme=');
+  });
+});
+
+describe('transitions.css — кнопочная система состояний', () => {
+  const css = readStyle('transitions.css');
+
+  it('.btn объявлен без border (border: none)', () => {
+    const m = css.match(/\.btn\s*\{([^}]*)\}/);
+    expect(m, 'ожидался базовый блок .btn').not.toBeNull();
+    expect(m![1]).toMatch(/border:\s*none/);
+  });
+
+  it('hover-правила живут только под @media (hover: hover) and (pointer: fine)', () => {
+    const [block, rest] = extractMediaBlock(css, '(hover: hover) and (pointer: fine)');
+    expect(block).toContain(':hover');
+    expect(rest, 'вне hover-медиа не должно быть :hover-правил').not.toContain(':hover');
+  });
+
+  it('reduced-motion гасит переходы', () => {
+    const [block] = extractMediaBlock(css, '(prefers-reduced-motion: reduce)');
+    expect(block).toMatch(/transition-duration:\s*0ms/);
+  });
+});
diff --git a/apps/web/src/styles/transitions.css b/apps/web/src/styles/transitions.css
new file mode 100644
index 0000000..ead3092
--- /dev/null
+++ b/apps/web/src/styles/transitions.css
@@ -0,0 +1,139 @@
+/* Система состояний и контент-анимаций — перенос из принятого мокапа
+   component-states-live: кнопки (ниже) и дорожки «забега» (в конце файла).
+   Кнопки: hover 140мс только на устройствах с настоящей мышью,
+   active мгновенный (≤60мс) везде включая тач, focus-visible — контур 3px со
+   смещением 2px (на сцене золотой), disabled — 0.55 без hover/active.
+   Отличие от мокапа: сцена определяется классом .btn-scene (в приложении нет
+   обёртки .panel.dark), литералы hover/active danger заменены токенами
+   --danger-hover/--danger-active, шрифт — var(--font-body). */
+
+.btn {
+  border: none;
+  border-radius: 10px;
+  font-family: var(--font-body);
+  font-weight: 700;
+  font-size: 16px;
+  padding: 13px 22px;
+  cursor: pointer;
+  transition: background-color var(--t-hover) ease-out, color var(--t-hover) ease-out;
+}
+.btn-primary {
+  background: var(--console-primary);
+  color: var(--gold);
+}
+.btn-secondary {
+  background: var(--console-secondary);
+  color: var(--ink);
+}
+.btn-quiet {
+  background: none;
+  color: var(--ink);
+  padding: 13px 10px;
+  border-radius: 8px;
+}
+.btn-danger {
+  background: none;
+  color: var(--error-light);
+  padding: 13px 10px;
+  border-radius: 8px;
+}
+.btn:disabled {
+  opacity: 0.55;
+  cursor: default;
+}
+
+/* hover — только устройства с настоящей мышью; на таче hover не появится вообще */
+@media (hover: hover) and (pointer: fine) {
+  .btn-primary:hover:not(:disabled) { background: var(--console-primary-hover); }
+  .btn-secondary:hover:not(:disabled) { background: var(--console-secondary-hover); }
+  .btn-quiet:hover:not(:disabled) { background: var(--console-strip); }
+  .btn-danger:hover:not(:disabled) { background: var(--danger-hover); }
+  .btn-scene:hover:not(:disabled) { background: var(--scene-surface-hover); }
+}
+
+/* active — мгновенно (≤60мс), работает везде, включая тач */
+.btn-primary:active:not(:disabled) { background: var(--console-primary-active); transition-duration: var(--t-press); }
+.btn-secondary:active:not(:disabled) { background: var(--console-secondary-active); transition-duration: var(--t-press); }
+.btn-quiet:active:not(:disabled) { background: var(--console-secondary); transition-duration: var(--t-press); }
+.btn-danger:active:not(:disabled) { background: var(--danger-active); transition-duration: var(--t-press); }
+.btn-scene:active:not(:disabled) { background: var(--scene-surface-active); transition-duration: var(--t-press); }
+
+/* focus-visible — контур только для клавиатуры; на сцене золотой */
+.btn:focus-visible {
+  outline: 3px solid var(--console-primary);
+  outline-offset: 2px;
+}
+.btn-scene:focus-visible { outline-color: var(--gold); }
+.btn:focus:not(:focus-visible) { outline: none; }
+
+/* Вариант ответа на сцене */
+.btn-scene {
+  background: var(--scene-surface);
+  color: var(--scene-text);
+  min-width: 260px;
+  text-align: left;
+  font-weight: 400;
+  font-size: 18px;
+  padding: 16px 20px;
+}
+.btn-scene b { color: var(--gold); margin-right: 10px; }
+
+/* Дорожки «забега» — перенос из мокапов component-states-live /
+   tracks-scene-projector-participant / console-reveal-tracks. fill — итог без
+   прироста, нормированный к лидеру; gain — золотой сегмент прироста последнего
+   раунда; оба анимируются width за var(--t-race) (контент-анимация, не hover).
+   Полотно дорожки зависит от контура: сцена — --track-canvas-dark, консоль —
+   --track-canvas-light. Заливка одна на оба контура — var(--track-fill)
+   (бриф T6; в мокапе console-reveal-tracks fill был --console-primary —
+   осознанное расхождение мокапов, берём токен темы). */
+
+.race-tracks .track-row { padding: 7px 0 9px; }
+.race-tracks .tr-top {
+  display: flex;
+  justify-content: space-between;
+  align-items: baseline;
+  gap: 10px;
+  margin-bottom: 4px;
+}
+.race-tracks .tr-name { font-weight: 700; font-size: 14px; }
+.race-tracks .tr-name .me {
+  color: var(--gold);
+  font-size: 12px;
+  font-weight: 400;
+  margin-left: 6px;
+}
+.race-tracks .tr-score { font-size: 14px; font-variant-numeric: tabular-nums; }
+.race-tracks .tr-lane {
+  height: 10px;
+  border-radius: 5px;
+  overflow: hidden;
+  display: flex;
+}
+.race-tracks.contour-scene { color: var(--scene-text); }
+.race-tracks.contour-scene .tr-lane { background: var(--track-canvas-dark); }
+.race-tracks.contour-scene .tr-more { color: var(--muted-scene); }
+.race-tracks.contour-console { color: var(--ink); }
+.race-tracks.contour-console .tr-lane { background: var(--track-canvas-light); }
+.race-tracks.contour-console .tr-more { color: var(--muted); }
+.race-tracks .fill {
+  background: var(--track-fill);
+  border-radius: 5px 0 0 5px;
+  height: 100%;
+  transition: width var(--t-race) ease-out;
+}
+/* Без прироста — закруглённый правый конец у fill */
+.race-tracks .fill.solo { border-radius: 5px; }
+.race-tracks .gain {
+  background: var(--gold);
+  height: 100%;
+  border-radius: 0 5px 5px 0;
+  transition: width var(--t-race) ease-out;
+}
