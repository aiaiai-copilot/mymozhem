+const findUnrepresentableCheckKind = (schema: unknown): string | undefined => {
+  const checks = (schema as ZodInternals)?._zod?.def?.checks ?? [];
+  for (const check of checks) {
+    const kind = (check as CheckInternals)?._zod?.def?.check;
