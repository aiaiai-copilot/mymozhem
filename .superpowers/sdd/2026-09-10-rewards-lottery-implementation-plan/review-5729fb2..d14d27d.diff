+    expect((await db.prisma.prize.findUniqueOrThrow({ where: { id: prize.id } })).quantity).toBe(1);
+    const again = await rewards.revoke(room.id, award.id, org.id); // no-op
+    expect(again.status).toBe('REVOKED');
