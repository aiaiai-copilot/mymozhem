+      .overrideProvider(APP_CONFIG)
+      .useValue(TEST_CONFIG)
+      .compile();
+    await moduleRef.init();
+    sweep = moduleRef.get(GuestSweepService);
+    tokens = moduleRef.get(TokenService);
