+    const ROUNDS = 20;
+    const big = { n: 1, blob: 'x'.repeat(8000) }; // < MAX_EVENT_PAYLOAD_BYTES
+    const small = { n: 2 };
+
+    for (let round = 0; round < ROUNDS; round++) {
