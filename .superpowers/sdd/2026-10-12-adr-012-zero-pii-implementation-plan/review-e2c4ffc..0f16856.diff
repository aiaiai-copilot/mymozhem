+  describe('rate limit (ORGANIZER_RATE_LIMIT=2, REQ-SEC-007)', () => {
+    let app: NestFastifyApplication;
+
+    beforeAll(async () => {
+      app = await createApp({ ORGANIZER_RATE_LIMIT: '2' });
