+    });
+
+    it('третий вызов → 429 RATE_LIMITED даже с ВЕРНЫМ токеном: лимитер ДО проверки (нет оракула)', async () => {
+      expect((await bootstrap(app, 'wrong-1')).statusCode).toBe(401);
