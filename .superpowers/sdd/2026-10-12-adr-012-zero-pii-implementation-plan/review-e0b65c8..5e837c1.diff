+    // Контрольная группа: свежий гость (createdAt > cutoff) в той же комнате.
+    const freshGuest = await seedGuestWithIp(room, org, { expired: false, ip: '10.9.9.9' });
+
+    const swept = await sweep.sweepExpiredGuests(new Date());
+
+    expect(swept).toBe(1);
